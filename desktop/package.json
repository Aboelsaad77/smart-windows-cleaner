{
  "name": "desktop",
  "version": "1.0.4",
  "description": "Safe, explainable Windows system cleaner and storage reclamation utility",
  "author": "Abdelrahman Aboelsaad",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/patch-nsis.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "node scripts/patch-nsis.mjs && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "package:dir": "node scripts/patch-nsis.mjs && electron-builder --dir --config electron-builder.yml --publish never",
    "verify-release": "node scripts/verify-release-artifacts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.5.0"
  }
}
